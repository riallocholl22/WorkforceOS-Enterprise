ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_VERSION=1.0.0
DEV_BOOTSTRAP_ENABLED=true
DEV_DEFAULT_ORG_NAME=AI Recruit Development Workspace
DEV_DEFAULT_ORG_SLUG=ai-recruit-development
DEV_ADMIN_EMAIL=

